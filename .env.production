# Production environment
AEGIS_ENV=production
AEGIS_DATA_DIR=data/synthea
AEGIS_AUTH_DISABLED=false
AEGIS_SECRET_KEY=${AEGIS_SECRET_KEY}

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=${OPENAI_API_KEY}
MODEL_NAME=gpt-4o

# Redis
REDIS_URL=redis://redis:6379

# Database
DATABASE_URL=postgresql://aegis:${POSTGRES_PASSWORD}@db:5432/aegis

# Logging
LOG_LEVEL=WARNING

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}
OTEL_SERVICE_NAME=aegis-production

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# Security
CORS_ORIGINS=https://your-domain.com
