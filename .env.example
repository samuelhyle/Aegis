# AEGIS configuration
AEGIS_ENV=development
AEGIS_DATA_DIR=data/synthea
AEGIS_AUTH_DISABLED=true
AEGIS_SECRET_KEY=change-me-in-production

# LLM integration
# Options: mock, local (Ollama), openai
LLM_PROVIDER=local
LLM_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...

# Redis caching
# REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=sqlite:///./aegis.db

# Vector Database (pgvector)
# VECTOR_DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis

# Logging
LOG_LEVEL=INFO

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
