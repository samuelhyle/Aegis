# Staging environment
AEGIS_ENV=staging
AEGIS_DATA_DIR=data/synthea
AEGIS_AUTH_DISABLED=false
AEGIS_SECRET_KEY=${AEGIS_SECRET_KEY}

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=${OPENAI_API_KEY}
MODEL_NAME=gpt-4o-mini

# Redis
REDIS_URL=redis://redis:6379

# Database
DATABASE_URL=postgresql://aegis:${POSTGRES_PASSWORD}@db:5432/aegis

# Logging
LOG_LEVEL=INFO

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-staging

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
