# Development environment
AEGIS_ENV=development
AEGIS_DATA_DIR=data/synthea
AEGIS_AUTH_DISABLED=true
AEGIS_SECRET_KEY=dev-secret-key-not-for-production

# LLM - MiniMax M3 (cloud) or MLX (local)
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M3
MINIMAX_API_KEY=sk-cp-Ln7WBVeUmvWd09jY0IJ8esoULXZYw1k2BazRMAfyO8Lv62pITVWzRsRXKQucVVyRbEIjv5LUX_vFrXqFyUB5Fs1OXsDe4Do1KJVszGhPH55TUloteWv5BhM
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Redis (disabled in dev by default)
# REDIS_URL=redis://localhost:6379

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis
VECTOR_DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis

# Logging
LOG_LEVEL=DEBUG

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-dev

# Rate limiting (relaxed in dev)
RATE_LIMIT_ENABLED=false
