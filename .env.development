# Development environment
AEGIS_ENV=development
AEGIS_DATA_DIR=data/synthea
AEGIS_AUTH_DISABLED=true
AEGIS_SECRET_KEY=dev-secret-key-not-for-production

# LLM - MLX with Gemma 426B (Apple Silicon native)
LLM_PROVIDER=mlx
LLM_MODEL=gemma-4-26b
MLX_MODEL_PATH=/Users/samuel.hyle/NEXT/llm/models/mlx/gemma-4-26b-a4b-it-4bit/text_only

# Redis (disabled in dev by default)
# REDIS_URL=redis://localhost:6379

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis
VECTOR_DATABASE_URL=postgresql://aegis:password@localhost:5432/aegis

# Logging
LOG_LEVEL=DEBUG

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aegis-dev

# Rate limiting (relaxed in dev)
RATE_LIMIT_ENABLED=false
